	<ideo>
		<overriddenWorshipRoomLabel>реликварий</overriddenWorshipRoomLabel>
		<foundation Class="IdeoFoundation_Deity">
			<def>Deity</def>
			<place>Ilwaba</place>
			<deities />
		</foundation>
		<name>Космотехнологизм</name>
		<adjective>космотехнологический</adjective>
		<memberName>Космотехник</memberName>
		<leaderTitleMale>Космический Лидер</leaderTitleMale>
		<leaderTitleFemale>Космический Лидер</leaderTitleFemale>
		<description>«Они молили о праведном пути. Я показал им, что ни моя смерть, ни смерть кого-либо другого не страшна, пока мы все вместе. Если я, даже ценой своей жизни, научу этому всех людей во вселенной, это будет моим величайшим триумфом.»

 - Монолог Nathan Cohen на ручье</description>
		<descriptionTemplate>«Они молили о праведном пути. Я показал им, что ни моя смерть, ни смерть кого-либо другого не страшна, пока мы все вместе. Если я, даже ценой своей жизни, научу этому всех людей во вселенной, это будет моим величайшим триумфом.»

 - Монолог Nathan Cohen на ручье</descriptionTemplate>
		<descriptionLocked>True</descriptionLocked>
		<culture>Astropolitan</culture>
		<iconDef>GeometryA</iconDef>
		<colorDef>LightMauve</colorDef>
		<memes>
			<li>Structure_Ideological</li>
			<li>Collectivist</li>
		</memes>
		<precepts>
			<li Class="Precept_Ritual">
				<name>Космотехнологический Реквием</name>
				<def>Funeral</def>
				<ID>1259</ID>
				<randomSeed>1348744777</randomSeed>
				<usesDefiniteArticle>True</usesDefiniteArticle>
				<nameMaker>NamerRitualFuneral</nameMaker>
				<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
				<ritualExpectedDesc>Вы можете провести {IDEOLIGION_adjective} похоронный обряд для {PAWN_nameDef}.</ritualExpectedDesc>
				<ritualExpectedDescNoAdjective>Вы можете провести похороны для {PAWN_nameDef}.</ritualExpectedDescNoAdjective>
				<playsIdeoMusic>True</playsIdeoMusic>
				<generatedAttachedReward>True</generatedAttachedReward>
				<sourcePattern>FuneralStandard</sourcePattern>
				<obligationTargetFilter Class="RitualObligationTargetWorker_GraveWithTarget">
					<def>GraveWithTargetsCorpse</def>
					<parent>Precept_1259</parent>
				</obligationTargetFilter>
				<targetFilter IsNull="True" />
				<behavior Class="RitualBehaviorWorker_Funeral">
					<def>Funeral</def>
				</behavior>
				<triggers>
					<li Class="RitualObligationTrigger_MemberDied">
						<mustBePlayerIdeo>True</mustBePlayerIdeo>
					</li>
				</triggers>
				<outcomeEffect Class="RitualOutcomeEffectWorker_FromQuality">
					<def>AttendedFuneral</def>
					<compDatas>
						<li IsNull="True" />
						<li Class="RitualOutcomeComp_DataThingPresence">
							<presentForTicks>
								<keys />
								<values />
							</presentForTicks>
						</li>
					</compDatas>
				</outcomeEffect>
				<layerWhitelist IsNull="True" />
				<layerBlacklist IsNull="True" />
			</li>
			<li Class="Precept_Ritual">
				<name>Космотехнологический Новый Год</name>
				<def>DateRitualConsumable</def>
				<ID>1258</ID>
				<randomSeed>1878887868</randomSeed>
				<usesDefiniteArticle>True</usesDefiniteArticle>
				<descOverride>Рождественская вечеринка. Участники соберутся вокруг Рождественской ёлки и будут веселиться.</descOverride>
				<nameMaker>NamerRitualFestival</nameMaker>
				<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
				<ritualExpectedDesc>Каждый год {DATE} {MEMBERS} могут отметить свой праздник.</ritualExpectedDesc>
				<shortDescOverride>рождественская вечеринка</shortDescOverride>
				<iconPathOverride>UI/Icons/Rituals/TreeCelebration</iconPathOverride>
				<patternGroupTag>RitualBuildingConsumer</patternGroupTag>
				<canBeAnytime>True</canBeAnytime>
				<playsIdeoMusic>True</playsIdeoMusic>
				<generatedAttachedReward>True</generatedAttachedReward>
				<sourcePattern>CelebrationTree</sourcePattern>
				<obligationTargetFilter Class="RitualObligationTargetWorker_ConsumableBuilding">
					<def>ChristmasTree</def>
					<parent>Precept_1258</parent>
				</obligationTargetFilter>
				<targetFilter IsNull="True" />
				<behavior>
					<def>CelebrationTree</def>
				</behavior>
				<triggers>
					<li Class="RitualObligationTrigger_Date">
						<mustBePlayerIdeo>True</mustBePlayerIdeo>
						<triggerDaysSinceStartOfYear>59</triggerDaysSinceStartOfYear>
					</li>
				</triggers>
				<attachableOutcomeEffect>NearbyFactionGoodwill</attachableOutcomeEffect>
				<outcomeEffect Class="RitualOutcomeEffectWorker_RemoveConsumableBuilding">
					<def>DestroyConsumableBuilding_ChristmasTree</def>
					<compDatas>
						<li Class="RitualOutcomeComp_DataThingPresence">
							<presentForTicks>
								<keys />
								<values />
							</presentForTicks>
						</li>
						<li Class="RitualOutcomeComp_DataRoomStatCached" />
						<li IsNull="True" />
					</compDatas>
				</outcomeEffect>
				<layerWhitelist IsNull="True" />
				<layerBlacklist IsNull="True" />
			</li>
			<li Class="Precept_Ritual">
				<name>Космотехнологический Фестиваль</name>
				<def>Festival</def>
				<ID>1253</ID>
				<randomSeed>-1261173941</randomSeed>
				<usesDefiniteArticle>True</usesDefiniteArticle>
				<descOverride>Танцевальная вечеринка под громкую музыку. Участники соберутся вместе, пообщаются, потанцуют, зарядятся хорошим настроением и улучшат отношения друг с другом.</descOverride>
