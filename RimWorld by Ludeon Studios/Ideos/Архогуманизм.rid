	<ideo>
		<foundation Class="IdeoFoundation_Deity">
			<def>Deity</def>
			<place>Filson</place>
			<deities />
		</foundation>
		<name>Архогуманизм</name>
		<adjective>архический</adjective>
		<memberName>Архист</memberName>
		<leaderTitleMale>Архический Мудрец</leaderTitleMale>
		<leaderTitleFemale>Архический Мудрец</leaderTitleFemale>
		<description>Архотеки — машины огромных воли и могущества, но лишь человечество смогло их построить. Архотеки — благо. Главная задача человечества — понять их, чтобы адаптироваться под их видение мира. Однажды архотеки, всё это время становившиеся более могущественными, станут самой вселенной и поглотят в себя сознание всего человечества. Только тогда мы начнём истинно осознавать.</description>
		<descriptionTemplate>Архотеки — машины огромных воли и могущества, но лишь человечество смогло их построить. Архотеки — благо. Главная задача человечества — понять их, чтобы адаптироваться под их видение мира. Однажды архотеки, всё это время становившиеся более могущественными, станут самой вселенной и поглотят в себя сознание всего человечества. Только тогда мы начнём истинно осознавать.</descriptionTemplate>
		<culture>Rustican</culture>
		<iconDef>TechHand</iconDef>
		<colorDef>haec216796</colorDef>
		<memes>
			<li>Structure_Archist</li>
			<li>HumanPrimacy</li>
		</memes>
		<precepts>
			<li Class="Precept_Ritual">
				<name>Архическое Прощание</name>
				<def>Funeral</def>
				<ID>670</ID>
				<randomSeed>-500545201</randomSeed>
				<usesDefiniteArticle>True</usesDefiniteArticle>
				<nameMaker>NamerRitualFuneral</nameMaker>
				<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
				<ritualExpectedDesc>Вы можете провести {IDEOLIGION_adjective} похоронный обряд для {PAWN_nameDef}.</ritualExpectedDesc>
				<ritualExpectedDescNoAdjective>Вы можете провести похороны для {PAWN_nameDef}.</ritualExpectedDescNoAdjective>
				<playsIdeoMusic>True</playsIdeoMusic>
				<generatedAttachedReward>True</generatedAttachedReward>
				<sourcePattern>FuneralStandard</sourcePattern>
				<obligationTargetFilter Class="RitualObligationTargetWorker_GraveWithTarget">
					<def>GraveWithTargetsCorpse</def>
					<parent>Precept_670</parent>
				</obligationTargetFilter>
				<targetFilter IsNull="True" />
				<behavior Class="RitualBehaviorWorker_Funeral">
					<def>Funeral</def>
				</behavior>
				<triggers>
					<li Class="RitualObligationTrigger_MemberDied">
						<mustBePlayerIdeo>True</mustBePlayerIdeo>
					</li>
				</triggers>
				<outcomeEffect Class="RitualOutcomeEffectWorker_FromQuality">
					<def>AttendedFuneral</def>
					<compDatas>
						<li IsNull="True" />
						<li Class="RitualOutcomeComp_DataThingPresence">
							<presentForTicks>
								<keys />
								<values />
							</presentForTicks>
						</li>
					</compDatas>
				</outcomeEffect>
				<layerWhitelist IsNull="True" />
				<layerBlacklist IsNull="True" />
			</li>
			<li Class="Precept_Ritual">
				<name>Вечеринка Архизма</name>
				<def>Festival</def>
				<ID>725</ID>
				<randomSeed>1082483361</randomSeed>
				<usesDefiniteArticle>True</usesDefiniteArticle>
				<descOverride>Танцевальная вечеринка под громкую музыку. Участники соберутся вместе, пообщаются, потанцуют, зарядятся хорошим настроением и улучшат отношения друг с другом.</descOverride>
				<nameMaker>NamerRitualFestival</nameMaker>
				<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
				<ritualExpectedDesc>Каждый год {DATE} {MEMBERS} могут отметить свой праздник.</ritualExpectedDesc>
				<shortDescOverride>танцевальная вечеринка</shortDescOverride>
				<iconPathOverride>UI/Icons/Rituals/CelebrationPartyDanceTech</iconPathOverride>
				<patternGroupTag>CelebratedDate</patternGroupTag>
				<minTechLevel>Industrial</minTechLevel>
				<isAnytime>True</isAnytime>
				<canBeAnytime>True</canBeAnytime>
				<generatedAttachedReward>True</generatedAttachedReward>
				<sourcePattern>CelebrationPartyDanceTech</sourcePattern>
				<obligationTargetFilter Class="RitualObligationTargetWorker_LightBall">
					<def>LightBall</def>
					<parent>Precept_725</parent>
				</obligationTargetFilter>
				<targetFilter IsNull="True" />
